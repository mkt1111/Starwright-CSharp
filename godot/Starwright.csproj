    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Starwright</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
